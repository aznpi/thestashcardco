# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SQUARE_PAYMENT: Square Web Payments SDK & Payments API configuration.
# Square Access Token for server-side payment processing (sandbox or production)
SQUARE_ACCESS_TOKEN="sandbox-sq0atb-YOUR_SQUARE_ACCESS_TOKEN"
# Square Application ID for Web Payments SDK card tokenization
VITE_SQUARE_APPLICATION_ID="sandbox-sq0idp-YOUR_SQUARE_APP_ID"
# Square Location ID associated with your merchant account
VITE_SQUARE_LOCATION_ID="YOUR_SQUARE_LOCATION_ID"
# Square Environment: 'sandbox' or 'production'
VITE_SQUARE_ENVIRONMENT="sandbox"
